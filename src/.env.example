# Copy this file to .env (next to docker-compose.yml).
# Docker Compose interpolates ${VAR} from this file when bringing up the stack.
#
# Running uvicorn directly without Docker? Copy this file to backend/.env and
# replace the hostnames `postgres`, `redis`, `qdrant` with `localhost`.

# ─── LLM providers ─────────────────────────────────────────────────────
# Sprint 1 endpoints don't call any LLM, so these can stay blank for now.
# Sprint 2 will need OPENAI_API_KEY (Mem0 embeddings + chat completions).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=agentic-494916
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Default model for the LLM client (Sprint 2+)
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=gemini-2.5-flash

# Logging

LOG_LEVEL=INFO

# ─── Sprint 1 infrastructure ───────────────────────────────────────────
# These match the docker-compose service names. For non-Docker runs,
# swap to localhost.
DATABASE_URL=postgresql+psycopg://tutor:tutorpass@postgres:5432/tutordb
ADMIN_EMAIL=
ADMIN_PASSWORD=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ─── AI Hook Logging (set by instructor; do not change) ────────────────
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/app

# Auth (Sprint 4) — appended by setup
JWT_SECRET=dev-jwt-secret-DO-NOT-USE-IN-PROD-1234567890
JWT_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:5173


# ─── Email provider (To-Be: weekly digest, password reset) ─────────────
# Resend.com free tier (100 mails/day). Leave blank → outbox rows stay
# 'pending' and the dispatcher logs them as stubs (safe for dev/tests).
RESEND_API_KEY=
EMAIL_FROM=A20 Tutor <no-reply@a20-tutor.local>
EMAIL_RESET_BASE_URL=http://localhost:5173/auth/reset

# ─── Observability (Sentry only — Datadog evaluated, dropped) ─────────
# Leave-blank-safe: init becomes a no-op when SENTRY_DSN is empty.
# Rationale: at MVP scale Sentry Tracing covers error + APM; Datadog's
# infra metrics only pay off past multi-host. Re-introduce later if needed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Scheduler (To-Be: cron jobs) ─────────────────────────────────────
# Set to false in tests / one-shot scripts so APScheduler doesn't start.
SCHEDULER_ENABLED=true
PRACTICE_HINTS_ENABLED=false
